# Render & Core Configuration
NODE_ENV=production
PORT=3000

# Database Configuration (Supabase Postgres)
# Use the Transaction Mode connection string for Drizzle on Render/Vercel
DATABASE_URL=postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true

# Supabase Configuration
SUPABASE_URL=https://[YOUR-PROJECT-REF].supabase.co
SUPABASE_ANON_KEY=[YOUR-ANON-KEY]
SUPABASE_SERVICE_ROLE_KEY=[YOUR-SERVICE-ROLE-KEY]

# WorkOS AuthKit Configuration
WORKOS_CLIENT_ID=[YOUR-WORKOS-CLIENT-ID]
WORKOS_API_KEY=[YOUR-WORKOS-API-KEY]
WORKOS_REDIRECT_URI=http://localhost:5000/api/auth/callback

# Auth Configuration
JWT_SECRET=[YOUR-RANDOM-SECRET]
OWNER_OPEN_ID=[YOUR-OPEN-ID]

# Storage Configuration (S3-compatible / Supabase Storage)
STORAGE_BUCKET=[YOUR-BUCKET-NAME]
STORAGE_ENDPOINT=[YOUR-STORAGE-ENDPOINT]
STORAGE_ACCESS_KEY_ID=[YOUR-ACCESS-KEY-ID]
STORAGE_SECRET_ACCESS_KEY=[YOUR-SECRET-ACCESS-KEY]
STORAGE_REGION=us-east-1

# LLM Configuration
LLM_API_URL=https://api.openai.com/v1
LLM_API_KEY=[YOUR-OPENAI-API-KEY]
LLM_MODEL=gpt-4o
